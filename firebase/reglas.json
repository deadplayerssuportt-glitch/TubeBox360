{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      ".read": true,
      ".indexOn": ["t"],
      "$id": {
        ".write": "$id.length >= 8 && $id.length <= 64",
        ".validate": "newData.hasChildren(['t']) && newData.child('t').isNumber() && newData.child('t').val() <= now + 60000",
        "t": { ".validate": true },
        "$other": { ".validate": false }
      }
    },

    "recomendados": {
      ".read": true,
      ".indexOn": ["t"],
      "$vid": {
        ".write": "$vid.matches(/^[A-Za-z0-9_-]{11}$/)",
        ".validate": "newData.hasChildren(['ti', 't']) && newData.child('t').val() == now",
        "ti": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "ch": { ".validate": "newData.isString() && newData.val().length <= 150" },
        "ci": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "l":  { ".validate": "newData.isString() && newData.val().length <= 12" },
        "a":  { ".validate": "newData.isString() && newData.val().length <= 320" },
        "t":  { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "version": {
      ".read": true,
      ".write": false
    }
  }
}
